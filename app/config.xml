<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://ngust.org/iptv" version="4.15.0" viewmodes="maximized">
    <tizen:application id="NgustIbTv1.ibtv" package="NgustIbTv1" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <name>NickFlix</name>
    <icon src="img/icon.png"/>
    <access origin="*" subdomains="true"/>
    <access origin="http://localhost" subdomains="true"/>
    <access origin="https://api-web.nhle.com" subdomains="true"/>
    <access origin="https://assets.nhle.com" subdomains="true"/>
    <access origin="https://site.api.espn.com" subdomains="true"/>
    <access origin="https://a.espncdn.com" subdomains="true"/>
    <access origin="https://raw.githubusercontent.com" subdomains="true"/>
    <access origin="https://v3-cinemeta.strem.io" subdomains="true"/>
    <access origin="https://images.metahub.space" subdomains="true"/>
    <!-- build.py inserts <access> entries for your provider and NAS here -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://tizen.org/privilege/mediastorage"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
