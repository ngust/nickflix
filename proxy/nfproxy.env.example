# Copy to nfproxy.env on the NAS and fill in NF_UPSTREAM. Never commit nfproxy.env.
# same scheme://host:port as "server" in NickFlix config.js
NF_UPSTREAM=http://your-provider.example.com:80
NF_PORT=8765
# seconds behind live handed to the TV as an instant burst (TV plays this far behind live)
NF_LEAD=20
# live cushion kept in RAM (~60-90 s of HD)
NF_RING_MB=96
# how far ahead of the TV a movie/episode is downloaded
NF_VOD_AHEAD_MB=160
# wait after closing the provider connection before opening another (1-connection account)
NF_GAP=1.5
# close the provider connection this long after the TV stops watching
NF_IDLE=10
# first upstream format for live: ts | hls (falls back to the other after 3 failures in a row)
NF_PREFER=ts
NF_HLS_VARIANT=highest
NF_CLIENT_STALL=75
# optional User-Agent if the provider insists on one
#NF_UA=
